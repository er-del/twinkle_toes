# Default API key source: env (server keys) or browser (personal keys)
API_KEY_SOURCE=env

# Server chat provider used in Server .env mode; choose groq, nvidia, or opencode-zen
AI_PROVIDER=nvidia

# Server-side provider keys. Never put real API keys in browser code or commit them.
GROQ_API_KEY=
NVIDIA_API_KEY=
NVIDIA_VOICE_API_KEY=
OPENCODE_ZEN_API_KEY=

# Models are configured here and shared by Server .env and Personal keys modes.
GROQ_MODEL=openai/gpt-oss-120b
NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash
OPENCODE_ZEN_MODEL=deepseek-v4.1-flash
NVIDIA_VOICE_MODEL=chatterbox-multilingual-tts
# NVIDIA_VOICE_SERVER=grpc.nvcf.nvidia.com:443
# NVIDIA_VOICE_FUNCTION_ID=ddacc747-1269-4fab-bfd9-8f593dead106
# NVIDIA_VOICE_EN=Chatterbox-Multilingual.en-US.Male
# NVIDIA_VOICE_HI=Chatterbox-Multilingual.hi-IN.Male

# Optional: set to 0 to run without an AI API key (manual controls still work)
AI_ENABLED=1
PORT=3000

# Speech recognition model and availability
STT_ENABLED=1
STT_MODEL=whisper-large-v3-turbo

# Web search: keyless Tavily works by default; add a free key for higher limits.
WEB_SEARCH_ENABLED=1
TAVILY_API_KEY=


# Optional HTTPS for Android microphone access. Generate a locally trusted
# certificate for localhost and your LAN IP; see the README.
HTTPS_KEY_PATH=certs\robot-key.pem
HTTPS_CERT_PATH=certs\robot.pem

# Fish Audio voice model and API key
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2.1-pro-free

# Defaults to the project's pinned voice; replace with a voice ID you may use.
# FISH_AUDIO_REFERENCE_ID_EN=
# FISH_AUDIO_REFERENCE_ID_HI=
